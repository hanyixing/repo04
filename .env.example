# ============================================================
# 环境变量示例。复制为 .env 并按需修改；.env 已被 .gitignore 忽略，切勿提交。
#   cp .env.example .env
# docker compose 与生产 profile（application-prod.yml）将读取以下变量。
# ============================================================

# ----- 数据库 -----
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=newbee_mall_db
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me-strong-password

# ----- 应用 -----
SERVER_PORT=28089

# ----- Jasypt 配置加密口令 -----
# 用于解密 application-prod.yml 中以 ENC(...) 包裹的支付接口密钥等敏感项。
# 生成密文示例（使用 jasypt 提供的命令行工具）：
#   java -cp jasypt-1.9.3.jar org.jasypt.intf.cli.JasyptPBEStringEncryptionCLI \
#        input="你的支付宝AppId" password="<这里填本变量的值>" \
#        algorithm=PBEWITHHMACSHA512ANDAES_256 \
#        ivGeneratorClassName=org.jasypt.iv.RandomIvGenerator
# 将输出结果包裹为 ENC(...) 后填入 application-prod.yml 的 newbee.pay.* 项。
JASYPT_ENCRYPTOR_PASSWORD=change-me-encryptor-password
