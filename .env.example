# ============================================================
# newbee-mall 环境变量配置模板
# 使用方法：复制本文件为 .env 并填入实际值
#   cp .env.example .env
# ============================================================

# ---------- 数据库配置 ----------
# MySQL root 密码（必须修改）
MYSQL_PASSWORD=your_secure_password_here
# 数据库名
MYSQL_DATABASE=newbee_mall_db
# 数据库用户（默认为 root）
MYSQL_USERNAME=root
# 宿主机暴露的 MySQL 端口
MYSQL_PORT=3306

# ---------- 应用配置 ----------
# 宿主机暴露的应用端口
APP_PORT=28089
# 应用服务端口（容器内部）
SERVER_PORT=28089

# ---------- 安全配置 ----------
# Jasypt 加密口令（用于解密 ENC(...) 配置项）
# 生成密文方法：
#   java -cp jasypt-1.9.3.jar org.jasypt.intf.cli.JasyptPBEStringEncryptionCLI \
#     input="你的明文" password="此处的口令" algorithm=PBEWITHHMACSHA512ANDAES_256 \
#     ivGeneratorClassName=org.jasypt.iv.RandomIvGenerator
JASYPT_ENCRYPTOR_PASSWORD=your_jasypt_password_here

# ---------- 日志配置 ----------
# 日志文件目录（容器内路径，一般无需修改）
LOG_PATH=/app/logs
